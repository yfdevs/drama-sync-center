// @see - https://www.electron.build/configuration/configuration
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.dramasync.center",
  asar: true,
  electronDownload: {
    mirror: "https://npmmirror.com/mirrors/electron/",
  },
  productName: "多平台剧数据同步中心",
  directories: {
    buildResources: "build/icons",
    output: "release/${version}",
  },
  publish: [
    {
      provider: "github",
      owner: "yfdevs",
      repo: "drama-sync-center",
      releaseType: "release",
    },
  ],
  files: ["dist", "dist-electron"],
  extraResources: [
    {
      from: "build/automation",
      to: "automation",
    },
    {
      from: "build/playwright-browsers",
      to: "playwright-browsers",
      filter: ["**/*", "!chromium_headless_shell-*/**"],
    },
  ],
  mac: {
    icon: "icon.icns",
    target: ["dmg"],
    artifactName: "${productName}-Mac-${version}-Installer.${ext}",
  },
  win: {
    icon: "icon.ico",
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    // Keep the local filename identical to the safe name recorded in latest.yml.
    // GitHub Release assets otherwise keep the Chinese filename while the updater
    // requests an ASCII alias that does not exist.
    artifactName: "drama-sync-center-setup-${version}.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    icon: "png",
    target: ["AppImage"],
    artifactName: "${productName}-Linux-${version}.${ext}",
  },
}
